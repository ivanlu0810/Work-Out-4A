        <mxCell id="addToMeal" value="加入餐次/設定份量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="1140" y="400" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="adjustServing" value="調整份量（克/份）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="1380" y="400" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="recalc" value="即時更新：每日/每週 kcal、蛋白、碳水、脂肪" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="1140" y="480" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="meetTargets" value="是否達標？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="1250" y="570" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="suggestAlt" value="推薦高蛋白/高纖或同類替代品" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="1140" y="660" width="260" height="70" as="geometry" />
