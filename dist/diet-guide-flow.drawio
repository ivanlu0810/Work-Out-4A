        <mxCell id="filterCat" value="類別篩選" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="1340" y="320" width="140" height="60" as="geometry" />
