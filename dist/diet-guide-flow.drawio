         <mxCell id="manualInput" value="手動輸入自訂食材/營養" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" parent="1" vertex="1">
           <mxGeometry x="1540" y="320" width="200" height="60" as="geometry" />
