        <mxCell id="inbodyBanner" value="InBody 匯入成功提示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaffd6;strokeColor=#a1cf5f;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="1180" y="50" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fillForm" value="填入/確認基本資料\n年齡/性別/身高/體重/活動強度/目標" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="1140" y="120" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="calcNeeds" value="點『計算營養需求』\n→ 取得 kcal/蛋白/碳水/脂肪 目標" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="1140" y="220" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="searchFood" value="搜尋食物關鍵字" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="1140" y="320" width="180" height="60" as="geometry" />
