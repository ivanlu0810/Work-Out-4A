<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36" version="28.2.5">
  <diagram id="diet-guide-flow" name="Diet Guide Flow (User Actions)">
    <mxGraphModel dx="1554" dy="815" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" value="開啟飲食指南頁面" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="140" y="40" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="title" value="看到本週餐單與營養目標" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="100" y="110" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="modeDialog" value="選擇模式：\n• 規則產生\n• 推薦菜單\n• 單品替換" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="240" y="190" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="applyTargets" value="套用目標/偏好\n（kcal/三大營養素/餐次/飲食型態/過敏）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="240" y="310" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ruleOutcome" value="規則產生\n→ 依配額分配至各餐\n→ 偏好與限制過濾\n→ 即時更新畫面" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="560" y="300" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="recoOutcome" value="推薦菜單\n→ 減脂/增肌/均衡模板\n→ 依目標微調份量\n→ 立即填入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="780" y="440" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="swapOutcome" value="單品替換\n→ 保持營養結構\n→ 挑選同類食物替代\n→ 回算份量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="60" y="430" width="360" height="100" as="geometry" />
        </mxCell>
        <mxCell id="saveBtn" value="點『儲存餐單』\n→ 儲存本週餐單\n→ 成功提示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="600" y="560" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="weekNav" value="點『上週/下週』\n→ 切換週區間\n→ 載入該週餐單並更新畫面" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="600" y="660" width="320" height="80" as="geometry" />
